{
  "name": "@triptyk/delegate-mcp",
  "version": "0.1.1",
  "description": "Generic multi-provider MCP delegate server for Claude Code. Sonnet orchestrates, cheap providers execute.",
  "type": "module",
  "bin": {
    "delegate-mcp": "dist/server.js"
  },
  "files": [
    "dist",
    "providers.example.yaml"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/server.js",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "publish": "npm publish --access public",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "yaml": "^2.6.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18.18"
  }
}
